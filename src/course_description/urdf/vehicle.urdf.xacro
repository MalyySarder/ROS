<?xml version="1.0"?>
<!-- Dimensions: course-kit v1-w06 models/course_ackermann/model.sdf.
     SI units; x forward, y left, z up. No Gazebo plugins. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">
  <xacro:arg name="wheelbase" default="0.8"/>
  <xacro:arg name="track" default="0.62"/>
  <xacro:arg name="wheel_radius" default="0.12"/>
  <xacro:property name="wheelbase" value="$(arg wheelbase)"/>
  <xacro:property name="track" value="$(arg track)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <material name="body_blue"><color rgba="0.05 0.36 0.72 1"/></material>
  <material name="wheel_black"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="sensor_orange"><color rgba="1 0.45 0.05 1"/></material>

  <link name="base_link">
    <inertial><mass value="12.0"/><inertia ixx="0.55" iyy="1.10" izz="1.40" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.12"/><geometry><box size="1.05 0.52 0.22"/></geometry><material name="body_blue"/></visual>
    <collision><origin xyz="0 0 0.12"/><geometry><box size="1.05 0.52 0.22"/></geometry></collision>
  </link>

  <xacro:macro name="wheel" params="name parent x y">
    <link name="${name}_wheel">
      <inertial><mass value="0.8"/>
        <inertia ixx="${0.8*(3*wheel_radius**2+wheel_width**2)/12}" iyy="${0.8*wheel_radius**2/2}"
                 izz="${0.8*(3*wheel_radius**2+wheel_width**2)/12}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="wheel_black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${parent}"/><child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="front" params="side sign">
    <link name="front_${side}_knuckle">
      <inertial><mass value="0.2"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><geometry><box size="0.04 0.04 0.04"/></geometry><material name="body_blue"/></visual>
      <collision><geometry><box size="0.04 0.04 0.04"/></geometry></collision>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/><child link="front_${side}_knuckle"/>
      <origin xyz="${wheelbase/2} ${sign*track/2} 0"/><axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="1.0"/>
    </joint>
    <xacro:wheel name="front_${side}" parent="front_${side}_knuckle" x="0" y="0"/>
  </xacro:macro>
  <xacro:front side="left" sign="${1}"/>
  <xacro:front side="right" sign="${-1}"/>
  <xacro:wheel name="rear_left" parent="base_link" x="${-wheelbase/2}" y="${track/2}"/>
  <xacro:wheel name="rear_right" parent="base_link" x="${-wheelbase/2}" y="${-track/2}"/>

  <!-- Sensor frames coincide in the supplied SDF; do not invent new offsets. -->
  <xacro:macro name="sensor" params="name size">
    <link name="${name}_link">
      <inertial><mass value="0.033333333333"/><inertia ixx="0.000333333333" iyy="0.000333333333" izz="0.000333333333" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><geometry><box size="${size}"/></geometry><material name="sensor_orange"/></visual>
      <collision><geometry><box size="${size}"/></geometry></collision>
    </link>
  </xacro:macro>
  <xacro:sensor name="camera" size="0.08 0.06 0.04"/>
  <xacro:sensor name="lidar" size="0.06 0.06 0.06"/>
  <xacro:sensor name="imu" size="0.03 0.03 0.02"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.28 0 0.38"/></joint>
  <joint name="lidar_joint" type="fixed"><parent link="camera_link"/><child link="lidar_link"/><origin xyz="0.28 0 0.38"/></joint>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0.28 0 0.38"/></joint>
</robot>
